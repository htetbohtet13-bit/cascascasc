# Server-only Neon database. Never use a VITE_ prefix for this value.
# Run neon/001_app_schema.sql and neon/002_phone_auth.sql in Neon first.
DATABASE_URL=postgresql://user:password@your-neon-host/neondb?sslmode=require

# Password required to enter /admin. Use a random password with at least 16 characters; keep it server-only.
# Add this exact variable in Vercel's server environment; never use a VITE_ prefix.
admin_secret=

# Server-only (Vercel functions). Paste GATEWAY_SECRET without quotes.
LOBBY_URL=https://j777ml.com
GAME_PROVIDER_DOMAIN=jlwin777.com
GATEWAY_URL=http://your-vps-ip:3001/
GATEWAY_SECRET=your-gateway-secret

# Partner callback IP allowlist (comma-separated). Defaults to 157.230.243.201
SLOT_ALLOWED_IPS=157.230.243.201

# MyanPay API (server only). Same names as Vercel env.
PAYMENT_API_URL=https://api.myanpay.cc
payment_secret=your-myanpay-api-key
# Shown as the payment recipient in the top-up screen. Change these to switch accounts.
kbzreceiver=09xxxxxxxxx
wavereceiver=09xxxxxxxxx
kbzname=Account Name
wavename=Account Name

# Local partner API only (not needed on Vercel)
SLOT_API_PORT=8787
