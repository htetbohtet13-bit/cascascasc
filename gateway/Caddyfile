{
    servers {
        timeouts {
            read_header 5s
            read_body 10s
            write 20s
            idle 30s
        }
        max_header_size 16KB
    }
}

# Replace this hostname with a DNS name pointing to the gateway VPS.
gateway.example.com {
    request_body {
        max_size 128KiB
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        -Server
    }
    @relay path /proxy /health
    handle @relay {
        reverse_proxy 127.0.0.1:3001 {
            transport http {
                dial_timeout 2s
                response_header_timeout 15s
            }
        }
    }
    handle {
        respond 404
    }
}
