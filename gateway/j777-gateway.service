[Unit]
Description=J777 game provider gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=j777-gateway
Group=j777-gateway
EnvironmentFile=/etc/j777-gateway.env
Environment=PORT=3001
Environment=PROVIDER_API_HOST=skm.african-buffalo.net
ExecStart=/usr/bin/python3 /opt/j777-gateway/proxy.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
