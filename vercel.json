{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "functions": {
    "api/game-login.js": {
      "includeFiles": "server/**",
      "maxDuration": 30
    },
    "api/provider-wallet/balance.js": {
      "includeFiles": "server/**",
      "maxDuration": 5
    },
    "api/provider-wallet/debit.js": {
      "includeFiles": "server/**",
      "maxDuration": 5
    },
    "api/provider-wallet/credit.js": {
      "includeFiles": "server/**",
      "maxDuration": 5
    },
    "api/provider-wallet/rollback.js": {
      "includeFiles": "server/**",
      "maxDuration": 5
    },
    "api/wallet/config.js": {
      "includeFiles": "server/**"
    },
    "api/wallet/deposit.js": {
      "includeFiles": "server/**",
      "maxDuration": 40
    },
    "api/wallet/withdraw.js": {
      "includeFiles": "server/**",
      "maxDuration": 120
    },
    "api/admin/index.js": {
      "includeFiles": "server/**"
    },
    "api/games.js": {
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    { "source": "/balance", "destination": "/api/provider-wallet/balance" },
    { "source": "/debit", "destination": "/api/provider-wallet/debit" },
    { "source": "/credit", "destination": "/api/provider-wallet/credit" },
    { "source": "/rollback", "destination": "/api/provider-wallet/rollback" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
