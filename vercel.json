{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" }
      ]
    }
  ],
  "functions": {
    "api/game-login.js": {
      "includeFiles": "server/**",
      "maxDuration": 30
    },
    "api/provider-wallet/balance.js": {
      "includeFiles": "server/**",
      "maxDuration": 5
    },
    "api/provider-wallet/debit.js": {
      "includeFiles": "server/**",
      "maxDuration": 5
    },
    "api/provider-wallet/credit.js": {
      "includeFiles": "server/**",
      "maxDuration": 5
    },
    "api/provider-wallet/rollback.js": {
      "includeFiles": "server/**",
      "maxDuration": 5
    },
    "api/wallet/config.js": {
      "includeFiles": "server/**"
    },
    "api/wallet/deposit.js": {
      "includeFiles": "server/**",
      "maxDuration": 120
    },
    "api/wallet/withdraw.js": {
      "includeFiles": "server/**",
      "maxDuration": 120
    },
    "api/admin/index.js": {
      "includeFiles": "server/**"
    },
    "api/games.js": {
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    { "source": "/balance", "destination": "/api/provider-wallet/balance" },
    { "source": "/debit", "destination": "/api/provider-wallet/debit" },
    { "source": "/credit", "destination": "/api/provider-wallet/credit" },
    { "source": "/rollback", "destination": "/api/provider-wallet/rollback" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
